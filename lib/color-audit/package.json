{
  "name": "color-audit-toolkit",
  "version": "1.0.0",
  "description": "Comprehensive color audit toolkit for React applications",
  "type": "module",
  "main": "index.js",
  "bin": {
    "color-audit": "./run-audit.js"
  },
  "scripts": {
    "audit": "node run-audit.js full",
    "audit:health": "node run-audit.js health",
    "audit:extract": "node run-audit.js extract",
    "audit:contrast": "node run-audit.js contrast",
    "audit:yellow": "node run-audit.js yellow"
  },
  "keywords": [
    "color",
    "audit",
    "accessibility",
    "wcag",
    "contrast",
    "react",
    "tailwind",
    "css"
  ],
  "dependencies": {
    "glob": "^10.3.0",
    "commander": "^11.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "*.js",
    "*.md",
    "package.json"
  ]
}